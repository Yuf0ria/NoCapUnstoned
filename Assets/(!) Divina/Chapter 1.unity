--- !u!114 &2026123273
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2026123271}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b6c293121aa4b04faef3401595e26cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  contactListManager: {fileID: 589611759}
  targetChatIndex: 0
  newChatData:
    profileImage: {fileID: 0}
    name: Mark
    phoneNumber: 
    chat: 
    messageList:
    - text: Don't you have 4 more projects to finish?
      name: Mark
      isSender: 1
      Choices:
      - I have two more projects to finish...
      - I got two more man... THIS IS HELL!
      - two... This week is insane man...
      linkBox: {fileID: 0}
      Notes: {fileID: 0}
    - text: Dude tell me about it.
      name: Mark
      isSender: 1
      Choices: []
      linkBox: {fileID: 0}
      Notes: {fileID: 0}
    - text: "I haven\u2019t touched grass in like 5 days working on \u201CEstablishing
        a relationship with coral size and complexity in comparison to guard crab
        species abundance\u201D"
      name: Mark
      isSender: 1
      Choices: []
      linkBox: {fileID: 0}
      Notes: {fileID: 0}
    - text: "I\u2019m losing it with how much I\u2019ve seen the word \u201Ccrab\u201D
        on this paper."
      name: Mark
      isSender: 1
      Choices:
      - You're definitely going to hate that word for a while.
      - You're goinng to get sick just hearing the word "crab."
      linkBox: {fileID: 0}
      Notes: {fileID: 0}
    - text: Oh absolutely.
      name: Mark
      isSender: 1
      Choices:
      - Jeez, it's already this late?
      - Oh man, I've been awake for a while now...
      - It's late, really late...
      linkBox: {fileID: 0}
      Notes: {fileID: 0}
    - text: I'm kinda starving so I should order some food now... BTW Mark, didn't
        you say you'll be heading to bed around this time?
      name: Kevin
      isSender: 0
      Choices: []
      linkBox: {fileID: 0}
      Notes: {fileID: 0}
    - text: "Oh yeah. I\u2019ve got some errands to do first thing in the morning
        so I\u2019ll be heading out now. \u2018Night dude."
      name: Mark
      isSender: 1
      Choices:
      - G'night man
      linkBox: {fileID: 0}
      Notes: {fileID: 0}
    startMessageList: []
    currentIndex: 0
    isResponding: 0
    isAutoProgressing: 0
    autoProgressTimer: 0
    contactUI: {fileID: 645694500}
    isUnread: 1
  messagingIcon: {fileID: 726277467628821053, guid: 5ccbf821adb9d6f43801066b733c0d2a, type: 3}
